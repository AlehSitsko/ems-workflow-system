# Production image for the frontend.
#
# Two stages: Node builds the static bundle, then an unprivileged Nginx serves it
# and proxies /api to the backend (same origin, so the session cookie is sent).
# The Node toolchain never ships in the final image. See docs/PRODUCTION_READINESS.md.

# ── build ────────────────────────────────────────────────────────────────────
FROM node:26-alpine AS build

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
# A production build resolves the API base to same-origin (see src/api/config.js),
# so no API URL needs baking in here. Serve from the root: this image's Nginx
# serves assets at /assets/*, so the bundle's base must be "/" (not the Pages/
# desktop default of /ems-workflow-system/) or the browser would 404 every asset.
ENV VITE_BASE_PATH="/"
RUN npm run build

# ── serve ────────────────────────────────────────────────────────────────────
FROM nginxinc/nginx-unprivileged:alpine

# The unprivileged image already runs as a non-root user and listens on 8080.
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080
