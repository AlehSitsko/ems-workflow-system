# Production image for the Flask backend.
#
# What makes it production over the dev image (backend/Dockerfile): a real WSGI
# server (Gunicorn) instead of Flask's dev server, an unprivileged user, and the
# prod dependency set. Source is baked in, not bind-mounted. See
# docs/PRODUCTION_READINESS.md.

FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    EMS_ENV=production

WORKDIR /app

# Dependencies first so editing application code does not reinstall them.
COPY requirements.txt requirements-prod.txt ./
RUN pip install -r requirements-prod.txt

COPY . .

# Run as an unprivileged user. The instance directory (SQLite file / mounted
# volume) is the only path the app writes to, so it is the only one chowned.
RUN useradd --create-home --uid 10001 appuser \
    && mkdir -p /app/instance \
    && chown -R appuser:appuser /app/instance
USER appuser

EXPOSE 5050

# Apply migrations (idempotent), then serve with Gunicorn using gunicorn.conf.py —
# which reads WEB_CONCURRENCY / GUNICORN_THREADS and, crucially, refuses to boot
# >1 worker in production without EMS_REDIS_URL (the in-memory event bus is
# process-local, so multi-worker SSE would silently drop events; see events.py).
# gthread workers keep a blocking database call on one request from starving the
# others. `exec` so signals reach Gunicorn, not the shell. An exec-form CMD is JSON.
CMD ["sh", "-c", "flask --app app db upgrade && exec gunicorn -c gunicorn.conf.py wsgi:app"]
