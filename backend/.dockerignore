# The host's virtualenv holds platform-specific binaries that would break inside
# the image, and it is the single biggest thing in this directory.
venv/
__pycache__/
*.pyc

# Never copy a developer's database or its backups into an image.
instance/
*.db
*.db-journal

.pytest_cache/
.env

# Signing key for web push — belongs on the host, never in an image layer.
vapid_private.pem

# PyInstaller desktop-build output — 100+ MB of frozen binaries; never part of a
# server image. (Regenerated by the desktop packaging step, gitignored.)
dist/
build/
*.spec

# Test toolchain, QA/E2E harnesses and dev-only manifests — belong in the repo and
# CI, not in a runtime image (prod runs gunicorn wsgi:app; dev runs app.py).
tests/
conftest.py
requirements-dev.txt
qa_server.py
e2e_server.py
scripts/prod_realtime_smoke.py
scripts/prod_s3_smoke.py

# Analysis / cache artifacts.
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/
