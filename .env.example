# Copy to .env and adjust. Docker Compose reads this file automatically.
#
# These are development defaults. Nothing here is a production configuration —
# see docs/PRODUCTION_READINESS.md.

# ── Backend ──────────────────────────────────────────────────────────────────
# Where the database lives. Compose overrides this to point at the named volume;
# a relative sqlite path resolves under backend/instance/.
DATABASE_URL=sqlite:///database.db

# 0.0.0.0 inside a container so the published port is reachable. Left unset when
# running directly, which keeps the dev server on loopback.
# FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5050
FLASK_DEBUG=1

# ── Frontend ─────────────────────────────────────────────────────────────────
# Resolved by the browser, so it is the host's published port rather than the
# compose service name.
VITE_API_BASE_URL=http://127.0.0.1:5050

# ── Web push (optional) ──────────────────────────────────────────────────────
# Browser push stays off unless the public key is set. Note the private key is
# NOT an environment variable: push_utils.py reads it from the file
# backend/vapid_private.pem, which is gitignored and never baked into an image.
# VAPID_PUBLIC_KEY=
# VAPID_CLAIMS_SUB=mailto:you@example.com
